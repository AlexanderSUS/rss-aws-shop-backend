{
  "name": "serverless-shop-backend",
  "version": "0.1.0",
  "bin": {
    "serverless-shop-backend": "bin/serverless-shop-backend.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "docker compose up -d && (jest --verbose --silent; docker compose down)",
    "cdk": "cdk",
    "fill:tables": "AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test AWS_DEFAULT_REGION=us-east-1 NODE_ENV=test LOCAL_DB_HOST=http://localhost:4566 ts-node ./test/fill-tables.ts",
    "clean": "rm ./{test,product*,import*,authorization*,lib,bin}/*.{d.ts,js}",
    "local:start": "./scripts/deploy-local.sh",
    "local:stop": "docker compose -f localstack-compose.yaml down"
  },
  "devDependencies": {
    "@smithy/types": "^3.2.0",
    "@smithy/util-stream": "^3.0.4",
    "@types/aws-lambda": "^8.10.140",
    "@types/jest": "^29.5.12",
    "@types/node": "20.12.7",
    "aws-sdk-client-mock": "^4.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.5"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.598.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-sns": "^3.609.0",
    "@aws-sdk/client-sqs": "^3.606.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@aws-sdk/util-dynamodb": "^3.602.0",
    "aws-cdk-lib": "^2.145.0",
    "constructs": "^10.3.0",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "source-map-support": "^0.5.21"
  }
}
